# Copy this file to .env and fill in real values.  (cp .env.example .env)

# Long random string used to sign cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Hash of the admin password (never the password itself). Generate with:
#   python -m flask --app app hash-password
# Keep the single quotes: the hash contains $ signs.
ADMIN_PASSWORD_HASH=''

# Code-guessing protection: wrong codes allowed per IP per window.
CODE_ATTEMPT_LIMIT=10
CODE_ATTEMPT_WINDOW_MINUTES=15

# Set to 1 if running behind a reverse proxy / HTTPS.
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0

# Shop time zone (decides which meets are upcoming)
SHOP_TIMEZONE=America/New_York

# Admin login protection: wrong passwords allowed per IP per 15 minutes,
# and minutes of inactivity before the admin is logged out.
ADMIN_LOGIN_ATTEMPT_LIMIT=5
ADMIN_SESSION_MINUTES=120

# Payments: "mock" (instant fake payment, the default) or "stripe" (Stripe
# Checkout in TEST mode). Stripe needs a TEST key: a restricted key (rk_test_...)
# with write access to Checkout Sessions, or a secret key (sk_test_...).
# Live keys are refused.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) for /shop/stripe/webhook. Locally, it's printed by:
#   stripe listen --forward-to localhost:5000/shop/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
