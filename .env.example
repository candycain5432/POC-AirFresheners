# Copy this file to .env and fill in real values.  (cp .env.example .env)

# Long random string used to sign cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Hash of the admin password (never the password itself). Generate with:
#   flask --app app hash-password
# Keep the single quotes: the hash contains $ signs.
ADMIN_PASSWORD_HASH=''

# Code-guessing protection: wrong codes allowed per IP per window.
CODE_ATTEMPT_LIMIT=10
CODE_ATTEMPT_WINDOW_MINUTES=15

# Set to 1 if running behind a reverse proxy / HTTPS.
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0
